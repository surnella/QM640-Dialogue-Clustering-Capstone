# ==============================================================================
# Capstone Project Git Ignore Configuration
# ==============================================================================

# Local documentation, templates, APA guides, drafts, and work folder
# (Everything in this folder is strictly local and NOT synced with Git)
docs/
docs/**
archive/
archive/**

# macOS system and temporary files
.DS_Store
.AppleDouble
.LSOverride
._*
~$*

# Python compiled bytecode, cache, and packaging artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
env/
venv/
ENV/
.venv/
env.bak/
venv.bak/

# Jupyter Notebook checkpoints
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# Local environment variables, secrets, and API credentials
.env
.env.*
secrets.yaml
*.pem
*.key

# Data files (raw corpora and canonical cache)
data/raw/*
!data/raw/.gitkeep
data/canonical/*
!data/canonical/.gitkeep
data/embeddings/*
!data/embeddings/.gitkeep
data/enterprise_sample/
data/enterprise_sample/**

# Evaluation output figures and tables (track generated artifacts)
outputs/figures/*
!outputs/figures/.gitkeep
!outputs/figures/*.png
outputs/tables/*
!outputs/tables/.gitkeep
!outputs/tables/*.csv

# Draft documents and alternative synopsis files
/*.docx
/*.pdf
!QM_640_Interim_Report_Sandeep_Surnella.docx
!QM_640_Interim_Report_Sandeep_Surnella.pdf
synopsis/*
!synopsis/QM_640_Capstone_Sandeep_Surnella_Synopsis.docx
!synopsis/QM_640_Capstone_Sandeep_Surnella_Synopsis.pdf

