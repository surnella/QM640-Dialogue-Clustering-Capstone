# ==============================================================================
# Capstone Project Git Ignore Configuration
# ==============================================================================

# Local documentation, templates, APA guides, drafts, and work folder
# (Everything in this folder is strictly local and NOT synced with Git)
docs/
docs/**

# macOS system and temporary files
.DS_Store
.AppleDouble
.LSOverride
._*
~$*

# Python compiled bytecode, cache, and packaging artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
env/
venv/
ENV/
.venv/
env.bak/
venv.bak/

# Jupyter Notebook checkpoints
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# Local environment variables, secrets, and API credentials
.env
.env.*
secrets.yaml
*.pem
*.key

# Data files (raw corpora and proprietary enterprise samples)
data/raw/*
!data/raw/.gitkeep
data/canonical/*
!data/canonical/.gitkeep
data/embeddings/*
!data/embeddings/.gitkeep
data/enterprise_sample/*
!data/enterprise_sample/.gitkeep

# Evaluation output figures and tables
outputs/figures/*
!outputs/figures/.gitkeep
outputs/tables/*
!outputs/tables/.gitkeep
